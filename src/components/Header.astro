---
import Mark from './Mark.astro';
import { LANGS, ui, type Lang } from '../i18n/ui';
import { basePath, localPath } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const home = localPath(lang, '/');
const here = basePath(Astro.url.pathname);
const sections = ['about', 'events', 'projects', 'board', 'contact'] as const;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home}>
      <Mark class="brand-mark" />
      <span class="brand-name">TUM Albanian<br />Student Society</span>
    </a>

    <nav class="nav" aria-label={t.nav.menu}>
      <ul role="list">
        {sections.map((id) => <li><a href={`${home}#${id}`}>{t.nav[id]}</a></li>)}
      </ul>
    </nav>

    <ul class="langs" role="list" aria-label={t.nav.language}>
      {
        LANGS.map((l) => (
          <li>
            <a href={localPath(l, here)} hreflang={l} lang={l} aria-label={ui[l].langName} aria-current={l === lang ? 'true' : undefined}>
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="menu">
      <summary>{t.nav.menu}</summary>
      <nav aria-label={t.nav.menu}>
        <ul role="list">
          {sections.map((id) => <li><a href={`${home}#${id}`}>{t.nav[id]}</a></li>)}
        </ul>
        <ul class="langs menu-langs" role="list" aria-label={t.nav.language}>
          {
            LANGS.map((l) => (
              <li>
                <a href={localPath(l, here)} hreflang={l} lang={l} aria-label={ui[l].langName} aria-current={l === lang ? 'true' : undefined}>
                  {l.toUpperCase()}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after choosing a section.
  document.querySelectorAll<HTMLDetailsElement>('.menu').forEach((menu) => {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    text-decoration: none;
    color: var(--ink);
  }

  .brand :global(.brand-mark) {
    width: 34px;
    height: 34px;
    color: var(--gjak);
    flex: none;
  }

  /* Echoes the club's original wordmark: wide-set serif capitals. */
  .brand-name {
    white-space: nowrap;
    font: 600 0.72rem/1.25 var(--display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav ul,
  .langs {
    display: flex;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: var(--gjak);
  }

  .langs {
    gap: 0.15rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }

  .langs a {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.06em;
    color: var(--ink-3);
    text-decoration: none;
    border-radius: 2px;
  }

  .langs a:hover {
    color: var(--ink);
  }

  .langs a[aria-current] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--gjak);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    white-space: nowrap;
    list-style: none;
    cursor: pointer;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.85rem 0 0.85rem 0.75rem;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary::after {
    content: '+';
    display: inline-block;
    margin-left: 0.5em;
    transition: transform 0.2s;
  }

  .menu[open] summary::after {
    transform: rotate(45deg);
  }

  .menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    z-index: 5;
    min-width: 13rem;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    padding: 0.5rem 0;
    box-shadow: 0 18px 40px -24px rgb(21 18 15 / 0.35);
  }

  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu .menu-langs {
    display: none;
    margin: 0.5rem 1.1rem 0.25rem;
    padding: 0.5rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .menu .menu-langs a {
    padding: 0;
  }

  .menu a {
    display: block;
    padding: 0.7rem 1.1rem;
    text-decoration: none;
  }

  .menu a:hover {
    color: var(--gjak);
  }

  @media (max-width: 960px) {
    .nav {
      display: none;
    }

    .menu {
      display: block;
    }

    .header-inner {
      gap: 0.75rem;
    }

    .langs {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 480px) {
    .header-inner > .langs {
      display: none;
    }

    .menu .menu-langs {
      display: flex;
    }
  }

  @media (max-width: 420px) {
    .brand-name {
      font-size: 0.64rem;
      letter-spacing: 0.12em;
    }

    .brand :global(.brand-mark) {
      width: 28px;
      height: 28px;
    }

    .langs a {
      min-width: 2rem;
    }
  }
</style>
