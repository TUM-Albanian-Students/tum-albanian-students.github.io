---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
import { dotted, localPath } from '../lib/site';

const t = ui.en;
---

<Base lang="en" title={t.notFound.title} noindex>
  <section class="wrap lost">
    <p class="code">404</p>
    <h1 class="display lost-title">{t.notFound.title}</h1>
    <p class="lead">{t.notFound.text}</p>
    <p class="lost-sq" lang="sq" set:html={dotted(ui.sq.notFound.title + '.')} />
    <div class="lost-links">
      <a class="button" href="/">{t.notFound.home} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="link" href={localPath('sq', '/')} hreflang="sq" lang="sq">{ui.sq.notFound.home}</a>
      <a class="link" href={localPath('de', '/')} hreflang="de" lang="de">{ui.de.notFound.home}</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4rem, 12vw, 9rem);
    max-width: calc(48rem + 2 * var(--gutter));
    margin-inline: 0;
  }

  .code {
    font: 500 0.75rem/1.4 var(--mono);
    letter-spacing: 0.09em;
    color: var(--gjak);
  }

  .lost-title {
    font-size: clamp(2.75rem, 7vw, 5rem);
  }

  .lost-sq {
    font: italic 500 1.5rem/1.3 var(--display);
    color: var(--ink-3);
  }

  .lost-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1rem;
  }
</style>
